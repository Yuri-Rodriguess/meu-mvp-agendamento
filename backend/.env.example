# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Chave usada para assinar os tokens JWT de login. NUNCA reaproveite este
# valor de exemplo nem deixe uma chave fixa no código-fonte.
# Gere uma própria com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Chave usada para autorizar o disparo do pipeline de testes (rota /api/run-tests).
# Gere uma chave própria, por exemplo com: python -c "import secrets; print(secrets.token_hex(16))"
TEST_RUNNER_API_KEY=troque-esta-chave-tambem

# Origens (frontend) autorizadas a chamar a API, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:5173
