# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# URL onde o backend (FastAPI) está rodando
VITE_API_URL=http://127.0.0.1:8000

# Deve ser IDÊNTICA à TEST_RUNNER_API_KEY definida em backend/.env
VITE_TEST_RUNNER_API_KEY=troque-esta-chave

# Opcional: @username do bot do Telegram (sem o @), usado só para montar o
# link de ativação do lembrete (t.me/<username>?start=...). Deve ser o
# mesmo bot do TELEGRAM_BOT_TOKEN em backend/.env. Sem isso, o botão de
# ativação do lembrete não aparece na lista de agendamentos.
VITE_TELEGRAM_BOT_USERNAME=
